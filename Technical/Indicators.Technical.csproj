<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>ATAS.Indicators.Technical</RootNamespace>
    <AssemblyName>ATAS.Indicators.Technical</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <!-- Default: only allow nullable annotations syntax (`?`) without enabling
         nullable warnings — keeps the legacy technical indicators compiling.
         Heatmap files opt into the strict regime via `#nullable enable` at the
         top of each file. -->
    <Nullable>annotations</Nullable>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(OftRoot)OFT.snk</AssemblyOriginatorKeyFile>
    <Configurations>Debug;Release;Publish</Configurations>
    <Platforms>AnyCPU;Cross</Platforms>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1903</WarningsNotAsErrors>
  </PropertyGroup>

	<PropertyGroup Condition=" '$(Platform)' == 'Cross' ">
		<UseWPF>False</UseWPF>
		<DefineConstants>$(DefineConstants);CROSS_PLATFORM</DefineConstants>
		<TargetFramework>net10.0</TargetFramework>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Platform)' != 'Cross' ">
		<UseWPF>True</UseWPF>
		<TargetFramework>net10.0-windows</TargetFramework>
	</PropertyGroup>

	<!-- Technical indicators render via System.Drawing/GDI+ and ship as Windows-only visuals even inside the Cross (Avalonia) assembly, so CA1416 is globally suppressed (matches the oft Directory.Build.props convention that doesn't reach this external repo). -->
	<PropertyGroup>
		<NoWarn>$(NoWarn);CA1416;CS8002</NoWarn>
	</PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Publish' ">
    <Optimize Condition=" '$(Optimize)' == '' ">true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(OftRoot)Attributes\Attributes.csproj" />
    <ProjectReference Include="$(OftRoot)DataFeedsCore\DataFeedsCore.csproj" />
    <ProjectReference Include="$(OftRoot)Indicators\Indicators.csproj" />
    <ProjectReference Include="$(OftRoot)Localization\Localization.csproj" />
    <ProjectReference Include="$(OftRoot)Renders\Rendering\Rendering.csproj" />
    <ProjectReference Include="$(UtilsRoot)Common\Common.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(OftRoot)OFTAssemblyInfo.cs" Link="Properties\OFTAssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(OftRoot)Tools\CrossPlatformAnalyzer\CrossPlatformAnalyzer.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <OutputItemType>Analyzer</OutputItemType>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup Condition=" '$(Platform)' == 'Cross' ">
	  <Compile Remove="**\*.Windows.cs" />
	  <None Include="**\*.Windows.cs" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />

	  <Compile Remove="**\*.xaml.cs" />
	  <None Include="**\*.xaml.cs" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />

	  <Compile Remove="**\*.xaml" />
	  <None Include="**\*.xaml" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
  </ItemGroup>

  <ItemGroup Condition=" '$(Platform)' != 'Cross' ">
	  <Compile Remove="**\*.Common.cs" />
	  <None Include="**\*.Common.cs" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
	  <ProjectReference Include="$(UtilsRoot)Windows\Windows.csproj" />
  </ItemGroup>
</Project>