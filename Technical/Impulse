    // === Candle Data Extraction (Extracción de datos de la vela) ===

    protected override void OnCalculate(int bar, decimal value)
    {
        if (bar < 1)
            return;

        var candle = GetCandle(bar);

        #region === Candle Core Stats ===
        // === Basic candle properties ===
        decimal open = candle.Open;
        decimal close = candle.Close;
        decimal high = candle.High;
        decimal low = candle.Low;
        decimal range = high - low;
        decimal body = Math.Abs(close - open);
        bool isGreen = close > open;
        bool isRed = close < open;
        #endregion

        #region === Order Flow Extraction ===
        // === Order flow statistics ===
        // EN: Total volume = sum of bid + ask + between
        // ES: Volumen total = suma de bid + ask + between
        decimal totalVolume = 0;
        decimal delta = 0;
        decimal pocPrice = close;
        decimal pocVolume = 0;
        decimal pocZoneVolume = 0;



        int buyImbalances = 0;
        int sellImbalances = 0;
        var imbalanceLevels = new Dictionary<decimal, int>();

        // === Cluster-level scan ===
        // Extract delta, POC, imbalances, volumes
        ScanClusters(candle, low, high, out totalVolume, out delta, out pocPrice, out pocVolume, out imbalanceLevels, out buyImbalances, out sellImbalances);

        // Volume in ±1 tick zone around POC
        // === Volumen alrededor del POC (zona ±1 tick) ===
        pocZoneVolume = GetPocZoneVolume(candle, pocPrice);
        #endregion

        #region === POC Importance Modifiers ===
        // EN: Adjust score based on POC importance (volume concentration, percentile, candle shape)
        // ES: Ajuste del score según relevancia del POC (volumen, percentil, forma de vela)

        // Ratio of volume concentrated around POC
        // Proporción de volumen concentrado alrededor del POC
        decimal pocZoneRatio = totalVolume > 0 ? pocZoneVolume / totalVolume : 0;

        // Adjust based on shape of volume
        // Ajuste basado en la forma del volumen de la vela
        decimal pocShapeMultiplier = 
            pocZoneRatio < 0.15m ? 0.5m :
            pocZoneRatio > 0.35m ? 1.2m : 
            1m;

        // Adjust based on percentile rank of POC volume
        //Ajuste basado en el percentil del volumen del POC
        int pocPercentile = CalculatePercentile(_pocVolumes, pocVolume);
        decimal pocImportanceMultiplier = 
            pocPercentile >= 90 ? 1.2m : 
            pocPercentile <= 30 ? 0.8m : 
            1m;

        // Adjust based on body-to-range ratio
        //Ajuste basado en el ratio cuerpo/rango
        decimal bodyRatio = range > 0 ? body / range : 0;
        decimal pocBodyImpact = bodyRatio < 0.2m ? 0.5m : 1m;

        // Final multipliers
        //Multiplicadores finales
        decimal segmentMultiplier = pocShapeMultiplier * pocBodyImpact;
        decimal totalMultiplier = pocShapeMultiplier * pocImportanceMultiplier * pocBodyImpact;

        #endregion

        #region Individual Scores

        #region === Score Block 1: POC Segment Position ===
        decimal scoreSegment = (GetBodySegmentScore(open, close, pocPrice, isGreen) * PocSegmentWeight* segmentMultiplier);
        #endregion

        #region === Score Block 2: POC Comparison vs Previous ===
        decimal scorePocCompare = (int)(GetPocComparisonScore(_prevPoc, pocPrice, close, body, PocComparisonWeight) *  totalMultiplier);
        #endregion

        #region === Score Block 3: Total Delta Strength ===
        decimal deltaPercentile = CalculatePercentile(isGreen ? _greenDeltas : _redDeltas, delta);
        decimal scoreDelta = GetDeltaStrengthScore(delta, deltaPercentile, isGreen, isRed, bodyRatio);
        #endregion

        #region === Score Block 4: Delta Change vs Previous ===
        decimal scoreDeltaChange = GetDeltaChangeScore(delta, _prevDelta, isGreen, isRed);
        #endregion

        #region === Score Block 5: Imbalances ===
        decimal scoreImbalance = GetImbalanceScore(
            buyImbalances,
            sellImbalances,
            delta,
            imbalanceLevels,
            high,
            low,
            bodyRatio);
        #endregion

        #region === Score Block 6: Closed Auction ===
        decimal scoreAuction = GetClosedAuctionScore(
            candle,
            close,
            high,
            low,
            isGreen,
            isRed,
            delta,
            bodyRatio);
        #endregion

        #endregion

        // === Final score aggregation ===
        decimal scorePocTotal = scoreSegment + scorePocCompare;
        decimal scoreDeltaTotal = scoreDelta + scoreDeltaChange;
        decimal scoreImbalanceTotal = scoreImbalance + scoreAuction;

        decimal signal = scorePocTotal + scoreDeltaTotal + scoreImbalanceTotal;

        var (positiveCount, negativeCount) = GetScoreComposition(scorePocTotal, scoreDeltaTotal, scoreImbalanceTotal);

        // === Update percentile histories ===
        AddRolling(_candleVolumes, totalVolume);
        AddRolling(_pocVolumes, pocVolume);
        AddRolling(isGreen ? _greenDeltas : _redDeltas, delta);

        // === Output to histogram ===
        _signalSeries[bar] = signal;
        _signalSeries.Colors[bar] = UseScoreCompositionColoring
            ? GetColorByScoreComposition(positiveCount, negativeCount)
            : GetColor(signal, isGreen);
      

        // === Store POC and delta for next bar ===
        _prevPoc = pocPrice;
        _prevDelta = delta;

        // === Alerts ===
        if (UseAlerts && bar == CurrentBar - 2 && _lastAlertBar != bar)
        {
           int direction = positiveCount == 3 ? 1 : (negativeCount == 3 ? -1 : 0);

           if (direction != 0)
           {
                string msg = direction > 0 ? "Strong Long Impulse" : "Strong Short Impulse";
                AddAlert(AlertFile, InstrumentInfo.Instrument, msg, AlertBGColor, AlertForeColor);
                _lastAlertBar = bar;
           }
        }

        /* DEBUG BLOCK: Score decomposition
        // === Visualización de líneas simples ===

