        if (scoreSegment < 0) shortBias += scoreSegment;
        if (scorePocCompare < 0) shortBias += scorePocCompare;
        if (scoreDelta < 0) shortBias += scoreDelta;
        if (scoreDeltaChange < 0) shortBias += scoreDeltaChange;
        if (scoreImbalance < 0) shortBias += scoreImbalance;
        if (scoreAuction < 0) shortBias += scoreAuction;

        _shortBiasLine[bar] = shortBias;
