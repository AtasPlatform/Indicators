    #region === Private Methods ===

    private void ScanClusters(IndicatorCandle candle, decimal low, decimal high,
    out decimal totalVolume, out decimal delta,
    out decimal pocPrice, out decimal pocVolume,
    out Dictionary<decimal, int> imbalanceLevels,
    out int buyImbalances, out int sellImbalances)
    {
        decimal maxVolume = 0; // EN: Used to determine POC (price with highest volume)
        totalVolume = 0;
        delta = 0;
        pocPrice = candle.Close;
        pocVolume = 0;
        buyImbalances = 0;
        sellImbalances = 0;
        imbalanceLevels = new();

        for (decimal price = low; price <= high; price += InstrumentInfo.TickSize)
        {
            var info = candle.GetPriceVolumeInfo(price);
            if (info == null) continue;

            totalVolume += info.Volume;
            delta += info.Ask - info.Bid;

            if (info.Volume > maxVolume)
            {
                maxVolume = info.Volume;
                pocPrice = price;
                pocVolume = info.Volume;
            }

            if (info.Volume >= MinImbalanceVolume && info.Bid > 0 && info.Ask > 0)
            {
                var ratio = (decimal)info.Ask / (info.Bid == 0 ? 1 : info.Bid);
                if (ratio > 2)
                    buyImbalances++;
                else if (ratio < 0.5m)
                    sellImbalances++;

                if (!imbalanceLevels.ContainsKey(price))
                    imbalanceLevels[price] = 0;
                imbalanceLevels[price]++;
            }
        }
    }


    private decimal GetPocZoneVolume(IndicatorCandle candle, decimal pocPrice)
    {
        decimal zoneVolume = 0;
        for (decimal price = pocPrice - InstrumentInfo.TickSize; price <= pocPrice + InstrumentInfo.TickSize; price += InstrumentInfo.TickSize)
        {
            var info = candle.GetPriceVolumeInfo(price);
            if (info != null)
                zoneVolume += info.Volume;
        }
        return zoneVolume;
    }

    /// <summary>
    /// EN: Scores the POC based on where it falls within the candle's body segments.
    /// ES: Puntuación del POC en función de su posición en los segmentos del cuerpo de la vela.
    /// </summary>
    private int GetBodySegmentScore(decimal open, decimal close, decimal poc, bool isGreen)
    {
        var bodySize = Math.Abs(close - open);
        if (bodySize == 0)
            return 0; // doji candle

        var segment = bodySize / 4;

        if (isGreen)
        {
            if (poc < open)
                return 2;
            if (poc >= open && poc < open + segment)
                return 1;
            if (poc >= open + segment && poc < open + 2 * segment)
                return 0;
            if (poc >= open + 2 * segment && poc < open + 3 * segment)
                return 0;
            if (poc >= open + 3 * segment && poc <= close)
                return -1;
            if (poc > close)
                return -2;
        }
        else // red candle
        {
            if (poc > open)
                return -2;
            if (poc <= open && poc > open - segment)
                return -1;
            if (poc <= open - segment && poc > open - 2 * segment)
                return 0;
            if (poc <= open - 2 * segment && poc > open - 3 * segment)
                return 0;
            if (poc <= open - 3 * segment && poc >= close)
                return 1;
            if (poc < close)
                return 2;
        }

        return 0; // Default if no condition matches
    }

    /// <summary>
    // EN: Score if POC moved in the direction of the close (not just higher/lower)
    // ES: Puntúa si el POC se mueve en la dirección del cierre (no solo más alto o más bajo)
    /// </summary>
    private decimal GetPocComparisonScore(decimal prevPoc, decimal currentPoc, decimal close, decimal body, int weight)
    {
        // EN: Compute normalized movement of the POC
        // ES: Movimiento normalizado del POC respecto al cuerpo
        decimal pocDiff = currentPoc - prevPoc;
        decimal normalizedPocMove = body > 0 ? Math.Abs(pocDiff) / body : 0;

        if (prevPoc == 0)
            return 0;



        bool pocUp = currentPoc > prevPoc;
        bool pocDown = currentPoc < prevPoc;
        bool closeAbovePoc = close > currentPoc;
        bool closeBelowPoc = close < currentPoc;

        if (pocUp && closeAbovePoc)
        {
            if (normalizedPocMove > 0.6m)
                return 2 * weight;
            else if (normalizedPocMove > 0.3m)
                return 1 * weight;
            else if (normalizedPocMove > 0.1m)
                return 0.5m * weight;
        }
        else if (pocDown && closeBelowPoc)
        {
            if (normalizedPocMove > 0.6m)
                return -2 * weight;
            else if (normalizedPocMove > 0.3m)
                return -1 * weight;
            else if (normalizedPocMove > 0.1m)
                return -0.5m * weight;
        }

        return 0;
    }

    /// <summary>
    /// EN: Computes score based on delta strength percentile.
    /// ES: Calcula puntuación en función del percentil de fuerza del delta.
    /// </summary>
    private decimal GetDeltaStrengthScore(decimal delta, decimal percentile, bool isGreen, bool isRed, decimal bodyRatio)
    {
        int deltaPercentile = CalculatePercentile(isGreen ? _greenDeltas : _redDeltas, delta);

        // Define dynamic thresholds
        int strongCutoff = DeltaPercentileThreshold;
        int mediumCutoff = DeltaPercentileThreshold - 20;
        int weakCutoff = DeltaPercentileThreshold - 30;

        decimal score = 0;

        if (isGreen && delta > 0)
        {
            if (deltaPercentile >= strongCutoff)
                score = TotalDeltaWeight * 2; // strong
            else if (deltaPercentile >= mediumCutoff)
                score = TotalDeltaWeight;     // moderate
            else if (deltaPercentile >= weakCutoff)
                score = TotalDeltaWeight * 0.5m; // weak
        }
        else if (isRed && delta < 0)
        {
            int inversePercentile = 100 - deltaPercentile;

            if (inversePercentile >= strongCutoff)
                score = -TotalDeltaWeight * 2; // strong
            else if (inversePercentile >= mediumCutoff)
                score = -TotalDeltaWeight;     // moderate
            else if (inversePercentile >= weakCutoff)
                score = -TotalDeltaWeight * 0.5m; // weak
        }

        // Reduce score in small-bodied candles (potential absorption)
        if (bodyRatio < 0.15m)
            score = score * 0.5m;

        return score;
    }

    /// <summary>
    /// EN: Scores the acceleration or deceleration of delta compared to the previous bar.
    /// ES: Puntúa la aceleración o desaceleración del delta respecto a la vela anterior.
    /// </summary>
    private decimal GetDeltaChangeScore(decimal delta, decimal prevDelta, bool isGreen, bool isRed)
    {
        if (prevDelta == 0)
            return 0;

        decimal deltaDiff = delta - prevDelta;
        decimal relativeChange = deltaDiff / Math.Abs(prevDelta);
        decimal score = 0;

        if (isGreen)
        {
            if (delta > 0)
            {
                if (relativeChange > 0.5m)
                    score = DeltaChangeWeight * 2;
                else if (relativeChange > 0.2m)
                    score = DeltaChangeWeight;
            }
            else if (delta < 0)
            {
                score = -DeltaChangeWeight;
            }
        }
        else if (isRed)
        {
            if (delta < 0)
            {
                if (relativeChange < -0.5m)
                    score = -DeltaChangeWeight * 2;
                else if (relativeChange < -0.2m)
                    score = -DeltaChangeWeight;
            }
            else if (delta > 0)
            {
                score = DeltaChangeWeight;
            }
        }

        return score;
    }

    /// <summary>
    /// EN: Scores the imbalance count and adjusts for delta conflict, concentration and body size.
    /// ES: Puntúa los desequilibrios y ajusta por conflicto con el delta, concentración y tamaño del cuerpo.
    /// </summary>
    private decimal GetImbalanceScore(
        int buyImbalances,
        int sellImbalances,
        decimal delta,
        Dictionary<decimal, int> imbalanceLevels,
        decimal high,
        decimal low,
        decimal bodyRatio)
    {
        int imbalanceCount = Math.Max(buyImbalances, sellImbalances);
        if (imbalanceCount < 3)
            return 0;

        decimal score = 1;

        if (imbalanceCount >= 6)
            score = 2;
        if (imbalanceCount >= 10)
            score = 3;

        // EN/ES: Penalize if imbalances contradict delta
        if ((buyImbalances > sellImbalances && delta < 0) ||
            (sellImbalances > buyImbalances && delta > 0))
            score *= 0.5m;

        // EN/ES: Penalize if imbalances are concentrated in a narrow range
        if (imbalanceLevels.Count > 0)
        {
            decimal minImb = imbalanceLevels.Keys.Min();
            decimal maxImb = imbalanceLevels.Keys.Max();
            decimal imbalanceRange = maxImb - minImb;
            decimal totalRange = high - low;

            if (totalRange > 0)
            {
                decimal rangeRatio = imbalanceRange / totalRange;
                if (rangeRatio < 0.2m)
                    score *= 0.5m;
            }
        }

        // EN/ES: Penalize for small body candles
        if (bodyRatio < 0.2m)
            score *= 0.5m;

        int direction = buyImbalances > sellImbalances ? 1 : -1;
        return direction * score * ImbalanceWeight;
    }

    /// <summary>
    /// EN: Scores a closed auction at the candle's extreme if it aligns with direction and location.
    /// ES: Puntúa una subasta cerrada en el extremo de la vela si coincide con la dirección y posición.
    /// </summary>
    private decimal GetClosedAuctionScore(
        IndicatorCandle candle,
        decimal close,
        decimal high,
        decimal low,
        bool isGreen,
        bool isRed,
        decimal delta,
        decimal bodyRatio)
    {
        var lowInfo = candle.GetPriceVolumeInfo(low);
        var highInfo = candle.GetPriceVolumeInfo(high);

        bool closedAtLow = lowInfo != null && lowInfo.Ask == 0 && lowInfo.Bid > 0;
        bool closedAtHigh = highInfo != null && highInfo.Bid == 0 && highInfo.Ask > 0;

        decimal range = high - low;
        decimal threshold = range * 0.25m;
        bool closeNearLow = (close - low) <= threshold;
        bool closeNearHigh = (high - close) <= threshold;

        decimal score = 0;

        if (closedAtLow && isGreen && closeNearLow)
            score = AuctionEdgeWeight;

        else if (closedAtHigh && isRed && closeNearHigh)
            score = -AuctionEdgeWeight;

        // EN/ES: Weaken the signal if the candle body is too small
        if (Math.Abs(bodyRatio) < 0.15m)
            score = score * 0.5m;

        // EN/ES: Weaken the signal if delta contradicts the expected direction
        if ((score > 0 && delta < 0) || (score < 0 && delta > 0))
            score = score * 0.5m;

        return score;
    }

    private (int positiveCount, int negativeCount) GetScoreComposition(decimal poc, decimal delta, decimal imbalance)
    {
        int pos = 0;
        int neg = 0;

        if (poc > 0) pos++;
        if (delta > 0) pos++;
        if (imbalance > 0) pos++;

        if (poc < 0) neg++;
        if (delta < 0) neg++;
        if (imbalance < 0) neg++;

        return (pos, neg);
    }

    /// <summary>
    /// EN: Adds a value to a rolling list, maintaining a fixed size.
    /// ES: Añade un valor a una lista móvil, manteniendo un tamaño fijo.
    /// </summary>
    private void AddRolling(List<decimal> list, decimal value)
    {
        list.Add(value);
        if (list.Count > HistorySize && HistorySize > 0)
            list.RemoveAt(0);
    }

    /// <summary>
    /// EN: Calculates the percentile of a value within a historical list.
    /// ES: Calcula el percentil de un valor dentro de una lista histórica.
    /// </summary>
    private int CalculatePercentile(List<decimal> list, decimal value)
    {
        if (list.Count == 0)
            return 0;

        var sorted = new List<decimal>(list);
        sorted.Sort(); // In-place sort is more efficient than OrderBy

        int pos = sorted.BinarySearch(value);
        if (pos < 0)
            pos = ~pos; // Get insertion index if not found

        return (int)Math.Round(100.0 * pos / sorted.Count);
    }

    /// <summary>
    /// EN: Determines the color of the bar based on signal direction and candle color.
    /// ES: Determina el color del histograma según la dirección de la señal y el color de la vela.
    /// </summary>
    private DrawingColor GetColor(decimal signal, bool isGreen)
    {
        if (signal == 0)
            return DrawingColor.Gray;

        // EN: Positive signal in green candle = valid long impulse
        if (isGreen && signal > 0)
            return DrawingColor.Green;

        // EN: Negative signal in red candle = valid short impulse
        if (!isGreen && signal < 0)
            return DrawingColor.Red;

        // EN: Contradictory candle (e.g., red body with long signal)
        if (isGreen && signal < 0)
            return DrawingColor.Yellow;

        if (!isGreen && signal > 0)
            return DrawingColor.Orange;

        return DrawingColor.Gray;
    }

    private DrawingColor GetColorByScoreComposition(int positiveCount, int negativeCount)
    {
        if (positiveCount == 0 && negativeCount == 0)
            return DrawingColor.Gray;


        if (positiveCount >= negativeCount)
        {
            return positiveCount switch
            {
                3 => DrawingColor.Lime,
                2 => DrawingColor.Green,
                1 => DrawingColor.Gold,
                _ => DrawingColor.Gray
            };
        }
        else
        {
            return negativeCount switch
            {
                3 => DrawingColor.Red,
                2 => DrawingColor.DarkRed,
                1 => DrawingColor.Orange,
                _ => DrawingColor.Gray
            };
        }
    }

    private System.Windows.Media.Color ToMediaColor(DrawingColor color)
    {
        return System.Windows.Media.Color.FromArgb(color.A, color.R, color.G, color.B);
    }

