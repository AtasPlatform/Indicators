<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ATAS.Indicators.Samples.Editors.AboutEditor"
             x:CompileBindings="False">

	<StackPanel Margin="0 2" Spacing="2">
		<TextBlock Text="About this indicator" FontWeight="Bold" FontSize="11"/>

		<TextBox Text="{Binding Mode=OneWay}"
		         IsReadOnly="True"
		         BorderThickness="0"
		         Background="Transparent"
		         FontSize="10"
		         TextWrapping="Wrap"
		         MaxHeight="100"/>
	</StackPanel>
</UserControl>
